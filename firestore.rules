rules_version = '2';

// ==========================================================================
//  قواعد أمان Firestore — الماهر
//
//  عزل الحسابات (تعدّد المستأجرين، من v1.15.0): كل مستند إمّا:
//    • بلا حقل ownerId  → مستند «قديم» في مساحة مشتركة، يقرأه ويكتبه أيّ
//      معلّم مسجَّل الدخول — تمامًا كسلوك ما قبل v1.15.0، فلا يُمَسّ.
//    • بحقل ownerId     → مستند حساب معزول، لا يقرأه أو يكتبه إلا صاحبه.
//  كانت هذه القاعدة مطبَّقة سابقًا على مستوى العميل فقط (DataService.inScope)
//  دون أيّ حماية فعليّة على الخادم — أيّ مستخدم مسجَّل دخول كان يقدر يقرأ أو
//  يعدّل بيانات أيّ حساب آخر مباشرةً عبر Firestore SDK. أصبحت الآن مفروضة
//  هنا فعليًّا (v1.21.1).
//
//  النشر:  npm run firebase:rules
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /** صاحب المستند — مساحة مشتركة (بلا ownerId) أو مالكه فقط. */
    function isOwner(data) {
      return !('ownerId' in data) || data.ownerId == request.auth.uid;
    }

    /**
     * كالسابقة، لكن تتسامح مع مستند غير موجود أصلًا (`resource == null`).
     * ضروريّة لأنّ Firestore يُقيِّم القواعد حتى على get()/delete() لمستند
     * غير موجود، وأيّ إشارة لـ `resource.data` حينها تُسبّب خطأ تقييم
     * (يُعامَل كرفض) بدل السماح بقراءة نتيجتها «غير موجود» بشكل طبيعي —
     * وهذا بالضبط ما كان يمنع `addManualSession`/`getOne` من العمل.
     */
    function isOwnerOrMissing(res) {
      return res == null || isOwner(res.data);
    }

    /**
     * ثغرة أمنيّة حقيقيّة مكتشفة ومؤكَّدة (مراجعة أمنيّة + اختبار اختراق مباشر
     * ضدّ الإنتاج الحقيقيّ، v1.25.4): `allow read` (يغطّي get المفرد وlist
     * الجماعيّ معًا) بشرط isOwnerOrMissing يحمي get/update/delete المفرد
     * فعليًّا (مؤكَّد)، لكن استعلام قائمة (list) بلا where كان يُرجع فعليًّا
     * مستندات مملوكة لحساب آخر تمامًا. أيّ شرط فيه OR (سواء || داخل تعبير
     * واحد، أو سطرا allow منفصلان، أو in بقيمتين) يُبطل قدرة Firestore على
     * «إثبات» أنّ استعلام القائمة آمن فيسمح به فعليًّا بدل رفضه كما يُفترض.
     * الشرط الوحيد المُثبَت آمنًا تجريبيًّا: مساواة واحدة بسيطة بلا أيّ OR.
     *
     * لذلك list قاعدة منفصلة عن get: تشترط مطابقة تامّة لـ ownerId — تعمل
     * تلقائيًّا مع DataService.scopedCol() (where('ownerId','==',uid) لكلّ
     * حساب معزول). **قرار متعمَّد بموافقة المستخدم: لا تدعم هذه القاعدة
     * الحسابات القديمة/المشتركة (بلا ownerId) في list** — إصلاح ذلك يتطلّب
     * هجرة بيانات (وسم كلّ مستند قديم بـ ownerId='SHARED') رُفضت الآن عمدًا
     * حفاظًا على البيانات كما هي. حساب قديم سيرى قائمة فارغة/توست «تعذّرت
     * المزامنة» (v1.19.2) بدل بياناته — تبقى بياناته سليمة في Firestore، فقط
     * list تُرفَض إلى أن تُنجَز الهجرة لاحقًا إن احتاج الأمر. get/update/
     * delete/create المفردة غير متأثّرة (نفس منطق isOwnerOrMissing الأصليّ).
     */
    function isListOwner(res) {
      return res.data.ownerId == request.auth.uid;
    }

    /**
     * مجموعات البيانات التعليميّة: قراءة مستند مفرد/تعديل/حذف تتطلّب ملكية
     * المستند الحاليّ (أو كونه مشتركًا قديمًا)، والتعديل يتطلّب أيضًا ألّا
     * تنقل الكتابة الجديدة المستند لملكيّة معلّم آخر (لا يمكن تحويل ownerId
     * لحساب غيرك). الإنشاء يتطلّب أن يكون المستند الجديد بلا ownerId
     * (حساب قديم) أو بـ ownerId يساوي كاتبه بالضبط (لا يمكن انتحال حساب آخر).
     * القوائم (list) مقيَّدة بقاعدة isListOwner المنفصلة أعلاه.
     */
    match /circles/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      // isPlatformOwner() هنا آمن بلا أيّ تحفّظ: create/update عمليّات مستند
      // واحد محدَّد (لا list)، مُثبَتة آمنة مع أيّ تعقيد OR طوال هذا اليوم —
      // يتيح للمالك استعادة بيانات محذوفة من platformDeletedItems بـ ownerId
      // الأصليّ الصحيح (لا يمكنه انتحال حساب آخر بأيّ طريقة أخرى).
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /students/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /sessions/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /attendance/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /recitations/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /evaluations/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /serd/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /exams/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /tajweedExams/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }
    match /tajweedExamResults/{id} {
      allow get, delete: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && (isOwner(request.resource.data) || isPlatformOwner());
    }

    /** سجل الحركات (v1.21.0) — دائم لا يُحذف أبدًا، حتى من صاحبه (يُستعاد بتعليمه restoredAt فقط، لا بالحذف). */
    match /activityLog/{id} {
      allow get: if signedIn() && isOwnerOrMissing(resource);
      allow list: if signedIn() && isListOwner(resource);
      allow update: if signedIn() && isOwnerOrMissing(resource) && isOwner(request.resource.data);
      allow create: if signedIn() && isOwner(request.resource.data);
      allow delete: if false;
    }

    // ملفّ المعلّم (اسم/بريد/جوال) — كلٌّ يقرأ ويعدّل ملفّه الخاصّ فقط. لا يوجد
    // في التطبيق أيّ مسار يقرأ ملفّ معلّم آخر (auth.service.ts يقرأ دومًا
    // uid المستخدم الحاليّ فقط) — القاعدة القديمة (`allow read: if signedIn()`)
    // كانت تسمح لأيّ حساب مسجَّل، حتى من مركز/مستأجر مختلف تمامًا، بقراءة اسم
    // وبريد وجوال أيّ معلّم آخر مباشرةً عبر الـ SDK (تعداد المستخدمين، تسريب
    // بيانات شخصيّة) دون أن يستفيد منها التطبيق نفسه في أيّ شيء — ثغرة حقيقيّة
    // مكتشفة في مراجعة أمنيّة، أُغلقت هنا (لا تغيير سلوكيّ على التطبيق).
    match /teachers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /**
     * لوحة المالك (v1.26.0) — طبقة مراقبة منفصلة تمامًا عن كل ما سبق، لا تلمس
     * قواعد circles/students/... الحاليّة إطلاقًا (قرار معماريّ متعمَّد، راجع
     * التعليق أعلى isListOwner: أيّ إضافة شرط OR جديد على قاعدة list قائمة
     * تُبطل إثباتها، حتى لو كان الشرط الجديد بمفرده آمنًا). بدلًا من ذلك:
     * مجموعات جديدة بالكامل، مملوكة فقط لهذه الميزة، كل قاعدة list فيها شرط
     * واحد بسيط بلا OR (isPlatformOwner() فقط) — بنفس شكل isListOwner المُثبَت
     * آمنًا تجريبيًّا. البريد أدناه يجب أن يطابق models.ts::OWNER_EMAIL تمامًا.
     */
    function isPlatformOwner() {
      return signedIn() && request.auth.token.email == 'samaster@assid.local';
    }

    // ملخّص كل معلّم (اسم/بريد/عدّادات) — يكتبه المعلّم نفسه فقط (uid مطابق)،
    // يقرأه المالك (كل الحسابات) أو المعلّم نفسه (مستنده فقط). get عمليّة
    // مستند مفرد لا list — آمنة مع تعقيد OR (خلافًا لـ list التي تبقى للمالك
    // حصرًا). صلاحيّة get للمعلّم نفسه ضروريّة: backfillPlatformTeacherSummary()
    // (v1.26.3) يقرأ مستنده الخاصّ أوّلًا ليتحقّق هل هو مكتمل قبل الكتابة —
    // خلل حقيقيّ مُكتشَف بالاختبار: بلا هذا يُرفَض الجميع برفض صلاحيّة صامت
    // فلا تُكتب أيّ بيانات تعبئة إطلاقًا لأيّ حساب، لا القديم فقط.
    match /platformTeachers/{uid} {
      allow get: if isPlatformOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isPlatformOwner();
      allow write: if signedIn() && request.auth.uid == uid;
      // إيقاف/استعادة حساب معلّم (v1.34) — تعديل حقل disabledAt فقط. عمليّة
      // مستند مفرد بمعرّف {uid} محدَّد سلفًا (لا list)، فآمنة مع OR بنفس منطق
      // create الحاليّ لدى circles/students/... أعلاه (isOwner() || isPlatformOwner()).
      allow update: if isPlatformOwner();

      match /circleMirror/{id} {
        allow get, list: if isPlatformOwner();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /studentMirror/{id} {
        allow get, list: if isPlatformOwner();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // مرآة أحداث فتح/إغلاق الجلسات (v1.34) — جهاز/منصّة كلّ حدث، لعرضها في
      // تفاصيل المعلّم من لوحة المالك. نفس نمط circleMirror/studentMirror بالضبط.
      match /sessionMirror/{id} {
        allow get, list: if isPlatformOwner();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // استعلام جماعيّ (collectionGroup) عبر كل circleMirror الفرعيّة (v1.34) —
    // تصفّح كل الحلقات عبر كل المعلّمين دفعة واحدة من لوحة المالك. نفس تحذير
    // الأمان أدناه بالضبط: الاسم circleMirror (لا "circles") متعمَّد وضروريّ.
    match /{path=**}/circleMirror/{id} {
      allow list: if isPlatformOwner();
    }

    // استعلام جماعيّ (collectionGroup) عبر كل studentMirror الفرعيّة — بحث عن
    // طالب عبر كل المعلّمين دفعة واحدة. الاسم studentMirror (لا "students")
    // متعمَّد وضروريّ للأمان: {path=**} يطابق حتى صفر مقاطع سابقة (مؤكَّد
    // تجريبيًّا على بيئة معزولة) — لو استُخدم اسم مطابق لمجموعة جذريّة حقيقيّة
    // موجودة (مثل "students")، هذه القاعدة كانت ستمنح المالك list غير مقيَّد
    // على تلك المجموعة الحقيقيّة مباشرة، بلا أيّ علاقة بالتصميم المقصود.
    match /{path=**}/studentMirror/{id} {
      allow list: if isPlatformOwner();
    }

    // عدّادات عامّة على مستوى المنصّة (مستند واحد ثابت: platformStats/global)
    // — أيّ معلّم مسجَّل الدخول يزيدها بـ increment() عند إضافة/حذف بياناته،
    // لا بيانات حسّاسة هنا (أرقام فقط)، فلا داعٍ لتقييد الكتابة على صاحبها.
    match /platformStats/{doc} {
      allow get: if isPlatformOwner();
      allow write: if signedIn();
    }

    // نسخة من كل حركة حذف حقيقيّة (مرآة عن activityLog وقت الحذف) — دائمة
    // لا تُحذف أبدًا، حتى من كاتبها، بنفس فلسفة activityLog الأصليّة.
    match /platformDeletedItems/{id} {
      allow get, list: if isPlatformOwner();
      allow create: if signedIn();
      // تعليم restoredAt بعد استعادة ناجحة — المالك فقط يقوم بهذا (المعلّم
      // لا يقرأ هذه المجموعة أصلًا فلن يحتاجها). كانت غائبة سهوًا فسبَّبت
      // فشل خطوة أخيرة من كل استعادة رغم نجاح استعادة البيانات نفسها فعليًّا.
      allow update: if isPlatformOwner();
      allow delete: if false;
    }

    // عمدًا بلا قاعدة عامّة شاملة (`match /{document=**}`) في آخر الملفّ:
    // قواعد Firestore تُقيَّم كـ OR بين كلّ match تطابق نفس المسار، فأيّ
    // قاعدة عامّة هنا كانت ستُبطل كلّ قواعد isOwner أعلاه (هذا بالضبط ما
    // كشفه اختبار العزل بين الحسابات — راجع v1.21.1). أيّ مسار غير مذكور
    // صراحةً أعلاه يُرفَض تلقائيًّا افتراضيًّا — وهذا هو السلوك الصحيح؛ عند
    // إضافة مجموعة جديدة أضِف لها قاعدة isOwner صريحة فوق، لا قاعدة عامّة.
  }
}

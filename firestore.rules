rules_version = '2';

// ==========================================================================
//  قواعد أمان Firestore — مركز أسيد
//
//  نموذج مبسّط ومشترك: كل معلّم مسجَّل الدخول يقرأ ويكتب البيانات المشتركة
//  (الحلقات، الطلاب، الجلسات، الحضور، التسميع، التقييم). الحماية الأساسية:
//  يجب أن يكون المستخدم مسجَّل الدخول عبر Firebase Authentication.
//
//  النشر مرة واحدة:  npm run firebase:rules
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // البيانات التعليمية المشتركة
    match /circles/{id}      { allow read, write: if signedIn(); }
    match /students/{id}     { allow read, write: if signedIn(); }
    match /sessions/{id}     { allow read, write: if signedIn(); }
    match /attendance/{id}   { allow read, write: if signedIn(); }
    match /recitations/{id}  { allow read, write: if signedIn(); }
    match /evaluations/{id}  { allow read, write: if signedIn(); }
    match /serd/{id}         { allow read, write: if signedIn(); }

    // ملفّات المعلّمين (اسم/جوال) — كلٌّ يعدّل ملفّه، ويقرأ الجميع
    match /teachers/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // أي مجموعة أخرى مستقبلًا: مسجَّل الدخول فقط
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}

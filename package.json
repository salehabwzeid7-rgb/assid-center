{
  "name": "assid-center",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently -k -n emulators,web -c green,cyan \"npm:emulators\" \"npm:start\"",
    "emulators": "node scripts/emulators.mjs",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "clean": "node scripts/clean.mjs",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "cap:sync": "npm run build:prod && npx cap sync android",
    "android:open": "npm run cap:sync && npx cap open android",
    "apk:debug": "npm run cap:sync && node scripts/build-apk.mjs debug",
    "apk:release": "npm run cap:sync && node scripts/build-apk.mjs release"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.1",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.28.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
